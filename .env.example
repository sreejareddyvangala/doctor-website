# =====================================================================
#  Copy this file to `.env.local` and fill in the values.
#  `.env.local` is git-ignored — never commit real keys.
# =====================================================================

# ---------------------------------------------------------------------
#  Supabase (browser)
#
#  Both values are safe to expose: anything prefixed VITE_ is compiled
#  into the JavaScript bundle and is readable by anyone. Row Level
#  Security is what actually protects patient data.
#
#  Find them at: Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# =====================================================================
#  SERVER-SIDE ONLY — never prefix any of the below with VITE_
#
#  A VITE_ prefix would compile the secret into the public bundle.
#  These belong in Supabase Edge Function secrets:
#    npx supabase secrets set KEY=value
# =====================================================================

# Full database access, bypasses RLS. Edge Functions only.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
#  WhatsApp Business Platform — Phase 8, not used yet
#
#  Unrelated to the "Chat on WhatsApp" button already on the site, which
#  is a plain wa.me link and needs no credentials.
# ---------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=

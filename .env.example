# =====================================================================
#  Copy this file to `.env.local` and fill in the values.
#  `.env.local` is git-ignored — never commit real keys.
# =====================================================================

# ---------------------------------------------------------------------
#  Supabase (browser)
#
#  Both values are safe to expose: anything prefixed VITE_ is compiled
#  into the JavaScript bundle and is readable by anyone. Row Level
#  Security is what actually protects patient data.
#
#  Find them at: Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# =====================================================================
#  SERVER-SIDE ONLY — never prefix any of the below with VITE_
#
#  A VITE_ prefix would compile the secret into the public bundle.
#  These belong in Supabase Edge Function secrets:
#    npx supabase secrets set KEY=value
# =====================================================================

# Full database access, bypasses RLS. Edge Functions only.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
#  WhatsApp Business Platform — Phase 8, not used yet
#
#  Unrelated to the "Chat on WhatsApp" button already on the site, which
#  is a plain wa.me link and needs no credentials.
# ---------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=

# =====================================================================
#  Area Finder API (server-side)
#
#  Read by server/ only: the Vite dev/preview middleware and
#  `node server/index.ts`. None of these reach the browser bundle.
# =====================================================================

# Data source behind /api/area-analysis: `osm` (OpenStreetMap, the default)
# or `mock` (the bundled sample dataset, for offline development and tests).
# AREA_DATA_SOURCE=osm

# Artificial delay (ms) for the mock source so the loading state is visible.
# AREA_MOCK_LATENCY_MS=700

# Comma-separated origins allowed to call the API cross-origin. Only needed
# when the UI is hosted on a different domain from the API.
# AREA_API_ALLOWED_ORIGINS=https://app.example.com

# Port for `npm start` (the standalone server).
# PORT=8787

# ---------------------------------------------------------------------
#  OpenStreetMap data source (AREA_DATA_SOURCE=osm)
#
#  Free, no API key. Nominatim and Overpass ask callers to identify
#  themselves and to stay well under one request per second; the app
#  queues requests accordingly and caches each city for a week, so a
#  city costs three upstream requests once.
# ---------------------------------------------------------------------
# Identify your deployment to the OSM services. Their policy requires it.
# AREA_OSM_USER_AGENT=AreaScout/1.0 (you@example.com)

# Endpoints. Point at a mirror or your own instance if you run one.
# AREA_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# AREA_OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Bias city lookups to these countries (ISO codes, comma-separated).
# Empty means worldwide.
# AREA_OSM_COUNTRY_CODES=in

# How a city is bounded in Overpass queries: `bbox` (its bounding box,
# answered in seconds) or `area` (its exact administrative boundary, which
# the public instance answers roughly thirty times slower).
# AREA_OSM_SCOPE=bbox

# On-disk cache location (git-ignored) and lifetime in hours.
# AREA_OSM_CACHE_DIR=.cache/osm
# AREA_OSM_CACHE_TTL_HOURS=168

# Catchment radius in metres around each locality centre when counting
# businesses; the most localities to score per city; and the fewest
# mapped businesses a locality needs to be scored at all.
# AREA_OSM_CATCHMENT_RADIUS_M=1500
# AREA_OSM_MAX_AREAS=60
# AREA_OSM_MIN_POIS=5

# Cities suggested in the UI before any analysis has run.
# AREA_OSM_SUGGESTED_CITIES=Hyderabad,Bengaluru,Mumbai,Chennai,Pune

# Credentials for paid data sources go here when they are connected.
# Never give them a VITE_ prefix.
# AREA_DATA_API_KEY=

# ---------------------------------------------------------------------
#  Area Finder (browser)
#
#  Where the UI sends analysis requests. Defaults to `/api/area-analysis`
#  on the same origin, which `npm run dev`, `npm run preview` and
#  `npm start` all provide. Set it only when the API is hosted elsewhere.
# ---------------------------------------------------------------------
# VITE_AREA_ANALYSIS_API_URL=https://api.example.com/api/area-analysis
